{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./lib",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "noImplicitAny": false,
    "baseUrl": "src",
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}