{
  "compilerOptions": {
    "target": "es6",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "jest"],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "noImplicitAny": false,
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
